<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LLMEval</RootNamespace>
    <AssemblyName>LLMEval.Abstractions</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>STAF.LLMEval.Abstractions</PackageId>
    <Version>3.3.1</Version>
    <Title>STAF.LLMEval.Abstractions — LLM evaluation contracts</Title>
    <Authors>Sooraj Ramachandran</Authors>
    <Company>Sooraj Ramachandran</Company>
    <Product>STAF.LLMEval</Product>
    <Description>Abstractions and DTOs for STAF.LLMEval: IEvaluationService, IAiProvider, IEmbeddingProvider, EvaluationRequest/Result, metrics contracts, and options (including opt-in run history). These assemblies also ship inside the STAF.LLMEval package. Prefer that package for one-line install.</Description>
    <PackageTags>LLM;LLM-evaluation;AI-testing;AI-evaluation;abstractions;embeddings;dotnet;net8;net9;net10;STAF</PackageTags>
    <PackageReleaseNotes>STAF.LLMEval.Abstractions 3.3.1 — Version aligned with STAF.LLMEval 3.3.1. The same assemblies ship inside STAF.LLMEval. See CHANGELOG.md.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/sooraj171/LLMEval</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sooraj171/LLMEval</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © Sooraj Ramachandran 2026</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\assets\icon.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

</Project>
