<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LLMEval</RootNamespace>
    <AssemblyName>LLMEval.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>STAF.LLMEval.Core</PackageId>
    <Version>3.3.0</Version>
    <Title>STAF.LLMEval.Core — LLM evaluation engine</Title>
    <Authors>Sooraj Ramachandran</Authors>
    <Company>Sooraj Ramachandran</Company>
    <Product>STAF.LLMEval</Product>
    <Description>Core evaluation engine for STAF.LLMEval: fluent Eval API, metrics (including TF-IDF and embeddings semantic similarity), suite/reports with opt-in run history, assertions, and providers (OpenAI, Azure OpenAI, Gemini, Ollama, Claude, Groq, Mistral). Prefer the STAF.LLMEval meta-package for one-line install.</Description>
    <PackageTags>LLM;LLM-evaluation;LLM-as-judge;AI-testing;AI-evaluation;RAG;Claude;Groq;Mistral;OpenAI;Gemini;Ollama;embeddings;BenchmarkDotNet;dotnet;net8;net9;net10;STAF</PackageTags>
    <PackageReleaseNotes>STAF.LLMEval.Core 3.3.0 — SemanticEmbedding opt-in; missing provider throws LLMEvalConfigurationException. TF-IDF semantic unchanged. See CHANGELOG.md.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/sooraj171/LLMEval</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sooraj171/LLMEval</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © Sooraj Ramachandran 2026</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Readme.md" Pack="true" PackagePath="README.md" />
    <None Include="..\assets\icon.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LLMEval.Abstractions\LLMEval.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

</Project>
