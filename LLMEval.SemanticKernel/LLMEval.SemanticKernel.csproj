<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LLMEval.SemanticKernel</RootNamespace>
    <AssemblyName>LLMEval.SemanticKernel</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>STAF.LLMEval.SemanticKernel</PackageId>
    <Version>3.3.1</Version>
    <Title>STAF.LLMEval.SemanticKernel — Semantic Kernel integration</Title>
    <Authors>Sooraj Ramachandran</Authors>
    <Company>Sooraj Ramachandran</Company>
    <Product>STAF.LLMEval</Product>
    <Description>Semantic Kernel integration for STAF.LLMEval: IAiProvider adapter over IChatCompletionService / Kernel for LLM-as-judge and grounding evaluations.</Description>
    <PackageTags>LLM;LLM-evaluation;Semantic-Kernel;AI-testing;AI-evaluation;dotnet;net8;net9;net10;STAF</PackageTags>
    <PackageReleaseNotes>STAF.LLMEval.SemanticKernel 3.3.1 — Depends on STAF.LLMEval 3.3.1, which contains the evaluation assemblies. See CHANGELOG.md.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/sooraj171/LLMEval</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sooraj171/LLMEval</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © Sooraj Ramachandran 2026</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\assets\icon.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile against Core. The published package depends on STAF.LLMEval, which contains these assemblies. -->
    <ProjectReference Include="..\LLMEval.Core\LLMEval.Core.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\LLMEval\LLMEval.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel.Abstractions" Version="1.80.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

</Project>
