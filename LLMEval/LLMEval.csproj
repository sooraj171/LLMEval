<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LLMEval</RootNamespace>
    <AssemblyName>LLMEval</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Meta-package: one-line install pulls Core + Abstractions; TypeForwards preserve assembly identity -->
    <PackageId>STAF.LLMEval</PackageId>
    <Version>3.0.0</Version>
    <Title>STAF.LLMEval — .NET LLM Evaluation and AI Testing Framework</Title>
    <Authors>Sooraj Ramachandran</Authors>
    <Company>Sooraj Ramachandran</Company>
    <Product>STAF.LLMEval</Product>
    <Description>STAF.LLMEval is a .NET library and AI testing framework for evaluating LLM and GenAI responses in unit tests and CI/CD. Score AI outputs with pluggable metrics (exact, keyword, TF-IDF semantic similarity, JSON/schema validation, relevance, heuristic grounding), LLM-as-judge, and RAG groundedness / hallucination detection. Includes fluent Eval API, rich assertions, Options/DI, JSON/JSONL/CSV evaluation suites, golden baseline comparison, HTML/JSON/Markdown/CSV reports, and GitHub Actions / Azure DevOps CI templates. Works with OpenAI, Azure OpenAI, Google Gemini, Ollama, Anthropic Claude, Groq, and Mistral on .NET 8/9/10. This meta-package depends on STAF.LLMEval.Core (and Abstractions); optional STAF.LLMEval.SemanticKernel for Semantic Kernel integration.</Description>
    <PackageTags>LLM;LLM-evaluation;LLM-as-judge;AI;AI-evaluation;AI-testing;GenAI;generative-AI;ChatGPT;GPT;OpenAI;Azure-OpenAI;AzureOpenAI;Gemini;Ollama;Claude;Anthropic;Groq;Mistral;RAG;RAG-evaluation;grounding;groundedness;hallucination;hallucination-detection;semantic-similarity;TF-IDF;exact-match;json-schema;relevance;golden-dataset;baseline-comparison;evaluation-suite;CSV;AI-assertions;unit-testing;xUnit;MSTest;NUnit;CI-CD;GitHub-Actions;Azure-DevOps;pass-rate;dotnet;net8;net9;net10;fluent-API;Semantic-Kernel;STAF</PackageTags>
    <PackageReleaseNotes>
STAF.LLMEval 3.0.0 — Architecture &amp; Ecosystem

- Multi-package: STAF.LLMEval (meta) → Core + Abstractions; TypeForwards for BC
- Providers: Claude, Groq, Mistral (+ existing OpenAI / Azure / Gemini / Ollama)
- Optional STAF.LLMEval.SemanticKernel package
- ASP.NET Core helper: AddLLMEval(IConfiguration)

See https://github.com/sooraj171/LLMEval/blob/main/CHANGELOG.md
    </PackageReleaseNotes>
    <RepositoryUrl>https://github.com/sooraj171/LLMEval</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sooraj171/LLMEval</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © Sooraj Ramachandran 2026</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Readme.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LLMEval.Core\LLMEval.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
