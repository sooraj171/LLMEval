<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LLMEval</RootNamespace>
    <AssemblyName>LLMEval</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- One-line install: Core + Abstractions assemblies are packed inside this nupkg -->
    <PackageId>STAF.LLMEval</PackageId>
    <Version>3.3.1</Version>
    <Title>STAF.LLMEval — .NET LLM Evaluation and AI Testing Framework</Title>
    <Authors>Sooraj Ramachandran</Authors>
    <Company>Sooraj Ramachandran</Company>
    <Product>STAF.LLMEval</Product>
    <Description>STAF.LLMEval is a .NET library and AI testing framework for evaluating LLM and GenAI responses in unit tests and CI/CD. Score AI outputs with pluggable metrics (exact, keyword, TF-IDF or embeddings semantic similarity, JSON/schema validation, relevance, heuristic grounding), LLM-as-judge, and RAG groundedness / hallucination detection. Includes fluent Eval API, rich assertions, Options/DI, JSON/JSONL/CSV evaluation suites, golden baseline comparison, opt-in run-history HTML trends, STAF-style HTML/JSON/Markdown/CSV reports, GitHub Actions / Azure DevOps CI templates, BenchmarkDotNet hot-path suite, and contributor docs. Works with OpenAI, Azure OpenAI, Google Gemini, Ollama, Anthropic Claude, Groq, and Mistral on .NET 8/9/10. This package contains the evaluation assemblies. Optional add-on: STAF.LLMEval.SemanticKernel.</Description>
    <PackageTags>LLM;LLM-evaluation;LLM-as-judge;AI;AI-evaluation;AI-testing;GenAI;generative-AI;ChatGPT;GPT;OpenAI;Azure-OpenAI;AzureOpenAI;Gemini;Ollama;Claude;Anthropic;Groq;Mistral;RAG;RAG-evaluation;grounding;groundedness;hallucination;hallucination-detection;semantic-similarity;TF-IDF;exact-match;json-schema;relevance;golden-dataset;baseline-comparison;evaluation-suite;CSV;AI-assertions;unit-testing;xUnit;MSTest;NUnit;CI-CD;GitHub-Actions;Azure-DevOps;pass-rate;dotnet;net8;net9;net10;fluent-API;Semantic-Kernel;BenchmarkDotNet;best-practices;performance;STAF</PackageTags>
    <PackageReleaseNotes>
STAF.LLMEval 3.3.1 — One package contains the evaluation assemblies

- LLMEval.Core and LLMEval.Abstractions ship inside this nupkg
- Install with: dotnet add package STAF.LLMEval
- 3.3.0 content: SemanticEmbedding opt-in, configuration failures throw, NuGet icon

See https://github.com/sooraj171/LLMEval/blob/main/CHANGELOG.md
    </PackageReleaseNotes>
    <RepositoryUrl>https://github.com/sooraj171/LLMEval</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sooraj171/LLMEval</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © Sooraj Ramachandran 2026</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Readme.md" Pack="true" PackagePath="README.md" />
    <None Include="..\assets\icon.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets keeps Core off the nuspec dependency list; its assemblies are packed below. -->
    <ProjectReference Include="..\LLMEval.Core\LLMEval.Core.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Core's package references do not flow through PrivateAssets, so restate the runtime deps here. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_EmbeddedAssembly Include="@(ReferenceCopyLocalPaths)"
                         Condition="('%(Filename)' == 'LLMEval.Core' or '%(Filename)' == 'LLMEval.Abstractions') and '%(Extension)' == '.dll'" />
      <_EmbeddedDoc Include="@(_EmbeddedAssembly->'%(RootDir)%(Directory)%(Filename).xml')"
                    Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')" />
      <BuildOutputInPackage Include="@(_EmbeddedAssembly);@(_EmbeddedDoc)" />
    </ItemGroup>
  </Target>

</Project>
